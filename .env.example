# Inferno — copy to .env and adjust.

APP_NAME=Inferno
ENVIRONMENT=development

# SQLite for local development. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./inferno.db
DATABASE_AUTO_MIGRATE=true

MODEL_STORAGE_PATH=./models

LLAMA_CPP_BINARY=/usr/local/bin/llama-server

# Hugging Face token for private/gated repositories (optional).
HF_TOKEN=

# Authentication is optional. Leave disabled for local use.
AUTH_ENABLED=false
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO
LOG_JSON=false

# Frontend (browser-reachable API origin).
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_WS_BASE=ws://localhost:8000
